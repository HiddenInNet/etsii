---
import Layout from '@/layouts/Layout.astro'
import BackgroundEffect from "@/components/utils/background/BackgroundEffect.astro"
import { contacto } from '@/data/tabs.json'

export const prerender = true;

const contactInfo = [
  {
    icon: 'M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z',
    title: 'Dirección Ubicación',
    value: 'Avda. Reina Mercedes, s/n',
    subValue: '41012 - Sevilla, España',
    badge: 'Campus Reina Mercedes',
  },
  {
    icon: 'M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.826-1.239-5.127-3.54-6.366-6.366l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z',
    title: 'Teléfonos de Contacto',
    value: '(+34) 954 55 27 57',
    subValue: 'Conserjería: (+34) 954 55 68 17',
    badge: 'Atención Telefónica',
  },
  {
    icon: 'M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75',
    title: 'Correo Electrónico',
    value: 'secretaria-etsii@listas.us.es',
    subValue: 'Dirección: secdir-etsii@us.es',
    badge: 'Soporte e Información',
  },
]
---

<Layout title={contacto.title} description={contacto.description}>
  <BackgroundEffect />

  <section class="relative z-10 min-h-screen w-full font-mono text-white pt-28 pb-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      
      <div class="mb-12 flex flex-col items-start gap-4 border-b border-neutral-800 pb-8">
        <div class="inline-flex items-center gap-2 rounded-full border border-yellow-400/30 bg-neutral-900/80 px-3.5 py-1.5 text-xs text-yellow-400 backdrop-blur-md shadow-[0_0_15px_rgba(250,204,21,0.1)]">
          <span class="h-2 w-2 rounded-full bg-yellow-400 animate-pulse"></span>
          <span>// CONTACTO_OFICIAL</span>
        </div>

        <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-5xl">
          Atención al <span class="text-transparent bg-clip-text bg-linear-to-r from-yellow-300 via-yellow-400 to-amber-500 drop-shadow-[0_0_15px_rgba(250,204,21,0.3)]">Estudiante y Centro</span>
        </h1>

        <p class="max-w-2xl text-sm leading-relaxed text-neutral-400 sm:text-base">
          Estamos a tu disposición en el Campus de Reina Mercedes. Contacta con Secretaría, Conserjería o Dirección para cualquier consulta académica o administrativa.
        </p>
      </div>

      <!-- CARDS DE INFORMACION -->
      <div class="mb-12 grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          contactInfo.map((item) => (
            <div class="group relative flex flex-col justify-between rounded-xl border border-neutral-800 bg-neutral-900/60 p-6 backdrop-blur-md transition-all duration-300 hover:border-yellow-400/50 hover:bg-neutral-900/90 hover:shadow-[0_0_20px_rgba(250,204,21,0.15)]">
              <!-- Adornos tech en esquinas -->
              <div class="absolute top-0 right-0 h-6 w-px bg-linear-to-b from-yellow-400/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
              <div class="absolute top-0 right-0 h-px w-6 bg-linear-to-l from-yellow-400/40 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

              <div>
                <div class="mb-4 flex items-center justify-between">
                  <div class="rounded-lg border border-yellow-400/20 bg-yellow-400/10 p-2.5 text-yellow-400">
                    <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                    </svg>
                  </div>
                  <span class="rounded border border-neutral-700 bg-neutral-800 px-2 py-0.5 text-[10px] uppercase font-semibold text-neutral-400">
                    {item.badge}
                  </span>
                </div>

                <h3 class="mb-2 text-sm font-bold text-neutral-400 uppercase tracking-wider">
                  {item.title}
                </h3>
                
                <p class="text-base font-bold text-white transition-colors group-hover:text-yellow-400">
                  {item.value}
                </p>
                <p class="mt-1 text-xs text-neutral-400">
                  {item.subValue}
                </p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <div class="relative rounded-2xl border border-yellow-400/30 bg-neutral-900/80 p-6 backdrop-blur-xl lg:col-span-5 shadow-[0_0_30px_rgba(0,0,0,0.8)]">
          <div class="flex items-center justify-between border-b border-neutral-800 pb-3 mb-4">
            <div class="flex items-center gap-2">
              <span class="h-3 w-3 rounded-full bg-red-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-yellow-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-green-500/80"></span>
            </div>
            <span class="text-[11px] text-neutral-500">// HORARIOS_ATENCION</span>
          </div>

          <div class="space-y-4 text-xs leading-relaxed text-neutral-300">
            <div>
              <p class="font-bold text-yellow-400 mb-1">&gt; Secretaría (Atención Presencial):</p>
              <p class="text-neutral-400">Lunes a Viernes: 09:00 - 14:00 h</p>
              <p class="text-[10px] text-neutral-500 italic">*Requiere cita previa previa solicitud en la web.</p>
            </div>

            <div class="border-t border-neutral-800/80 pt-3">
              <p class="font-bold text-yellow-400 mb-1">&gt; Conserjería y Apertura de Centro:</p>
              <p class="text-neutral-400">Lunes a Viernes: 08:00 - 21:45 h</p>
            </div>

            <div class="border-t border-neutral-800/80 pt-3">
              <p class="font-bold text-yellow-400 mb-1">&gt; Laboratorios de Hardware:</p>
              <p class="text-neutral-400">L-J: 09:00 - 21:00 h | V: 09:00 - 14:00 h</p>
            </div>
          </div>
        </div>

        <!-- Formulario de Contacto / Enviar Mensaje -->
        <div class="rounded-2xl border border-neutral-800 bg-neutral-900/60 p-6 backdrop-blur-md lg:col-span-7">
          <h2 class="mb-4 text-lg font-bold text-white flex items-center gap-2">
            <span class="text-yellow-400">&lt;</span> Donde estamos <span class="text-yellow-400 font-normal">/&gt;</span>
          </h2>
            <div class="flex justify-center items-center">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2085.237373502055!2d-5.988232112244228!3d37.35879345275079!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd126dd4a3055555%3A0x29c3f634f8a021b8!2sEscuela%20T%C3%A9cnica%20Superior%20de%20Ingenier%C3%ADa%20Inform%C3%A1tica!5e0!3m2!1ses!2ses!4v1790086010930!5m2!1ses!2ses" width="600" height="300" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>          
        </div>
      </div>
    </div>
  </section>
</Layout>
---
import LogoImage from '@/assets/images/logo-image.avif'

const navLinks = [
  { name: 'Inicio', href: '/' },
  { name: 'Titulaciones', href: '/titulaciones' },
  { name: 'Calendario', href: '/calendario' },
  { name: 'Horario', href: '/horario' },
  { name: 'Contacto', href: '/contacto' },
]
---

<header
  id="main-header"
  class="fixed top-0 left-0 z-50 w-full border-b border-neutral-800 bg-neutral-950/80 font-mono text-white backdrop-blur-xl transition-all duration-300"
>
  <div
    class="h-0.5 w-full bg-linear-to-r from-transparent via-yellow-400 to-transparent opacity-80 shadow-[0_0_12px_#facc15]"
  >
  </div>

  <div
    id="main-container"
    class="mx-auto h-20 w-full max-w-7xl px-4 sm:px-6 lg:px-8"
  >
    <div class="flex h-full items-center justify-between">
      <a
        href="/"
        class="group flex items-center gap-3 transition-all duration-300"
      >
        <div
          class="relative flex items-center justify-center rounded-lg border border-yellow-400/20 bg-neutral-900/60 p-1 transition-all duration-300 group-hover:border-yellow-400 group-hover:shadow-[0_0_15px_rgba(250,204,21,0.3)]"
        >
          <img
            src={LogoImage.src}
            alt="Logo ETSII Universidad de Sevilla"
            class="h-10 w-auto object-contain sm:h-12"
            fetchpriority="high"
          />
        </div>
        <div class="flex flex-col border-l border-neutral-800 pl-3">
          <div class="flex items-center gap-1.5">
            <span
              class="text-base font-extrabold tracking-widest text-yellow-400 drop-shadow-[0_0_8px_rgba(250,204,21,0.5)] sm:text-lg"
            >
              ETSII
            </span>
            <span
              class="h-1.5 w-1.5 animate-pulse rounded-full bg-yellow-400 shadow-[0_0_6px_#facc15]"
            ></span>
          </div>
          <span
            class="hidden text-[10px] font-medium tracking-wider text-neutral-400 uppercase sm:inline"
          >
            Universidad de Sevilla
          </span>
        </div>
      </a>

      <!-- NAVEGACIÓN DESKTOP (HUD Tech Style) -->
      <nav
        class="hidden items-center gap-1 rounded-full border border-neutral-800 bg-neutral-900/50 p-1.5 backdrop-blur-md md:flex"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="group relative px-4 py-2 text-xs font-semibold tracking-wider text-neutral-300 uppercase transition-all duration-300 hover:text-yellow-400"
            >
              <span class="relative z-10 flex items-center gap-1">
                <span class="text-yellow-400 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                  &lt;
                </span>
                {link.name}
                <span class="text-yellow-400 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
                  /&gt;
                </span>
              </span>
              <span class="absolute inset-x-2 bottom-0 h-0.5 scale-x-0 bg-yellow-400 shadow-[0_0_8px_#facc15] transition-transform duration-300 ease-out group-hover:scale-x-100" />
            </a>
          ))
        }
      </nav>

      <!-- BOTÓN MENÚ HAMBURGUESA (MÓVIL TECH) -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          class="relative inline-flex items-center justify-center rounded-lg border border-yellow-400/30 bg-neutral-900/80 p-2.5 text-yellow-400 transition-all duration-300 hover:border-yellow-400 hover:bg-yellow-400/10 hover:shadow-[0_0_15px_rgba(250,204,21,0.3)] focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Abrir menú principal"
        >
          <!-- Ícono de Menú CERRADO -->
          <svg
            id="icon-open"
            class="block h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>

          <!-- Ícono de Menú ABIERTO (X) -->
          <svg
            id="icon-close"
            class="hidden h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<!-- OVERLAY (Sombra de fondo fuera del header para capturar los clics limpios) -->
<div
  id="mobile-overlay"
  class="pointer-events-none fixed inset-0 z-40 bg-black/70 opacity-0 backdrop-blur-sm transition-opacity duration-300 md:hidden"
>
</div>

<!-- NAVEGACIÓN MÓVIL (Con flexbox vertical y dinámico dvh para asegurar el footer) -->
<aside
  id="mobile-menu"
  class="fixed top-20 left-0 z-50 flex h-[calc(100dvh-5rem)] w-72 -translate-x-full flex-col justify-between border-r border-yellow-400/20 bg-neutral-950/95 px-6 pt-6 pb-6 font-mono text-white backdrop-blur-2xl transition-transform duration-300 ease-in-out md:hidden"
>
  <div class="relative w-full">
    <!-- Decoración Cyberpunk -->
    <div
      class="absolute top-0 right-0 h-16 w-px bg-linear-to-b from-yellow-400 to-transparent"
    >
    </div>
    <div
      class="absolute top-0 right-0 h-px w-16 bg-linear-to-l from-yellow-400 to-transparent"
    >
    </div>

    <div class="mb-4 border-b border-neutral-800 pb-2">
      <span class="text-xs tracking-widest text-neutral-500 uppercase"
        >// NAVEGACIÓN</span
      >
    </div>

    <nav class="flex flex-col gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link group flex items-center justify-between rounded-lg border border-transparent px-4 py-3 text-sm font-semibold tracking-wider text-neutral-300 uppercase transition-all duration-200 hover:border-yellow-400/40 hover:bg-yellow-400/10 hover:text-yellow-400 hover:shadow-[0_0_12px_rgba(250,204,21,0.15)]"
          >
            <span>{link.name}</span>
            <span class="text-yellow-400 opacity-0 transition-opacity duration-200 group-hover:opacity-100">
              &rarr;
            </span>
          </a>
        ))
      }
    </nav>
  </div>

  <div class="w-full border-t border-neutral-800 pt-4">
    <div class="flex items-center gap-2 text-[11px] text-neutral-500">
      <span class="h-2 w-2 rounded-full bg-yellow-400/80"></span>
      <span>ETSII • US</span>
    </div>
  </div>
</aside>

<script>
  function setupHeader() {
    const menuBtn = document.getElementById('mobile-menu-btn')
    const mobileMenu = document.getElementById('mobile-menu')
    const mobileOverlay = document.getElementById('mobile-overlay')
    const iconOpen = document.getElementById('icon-open')
    const iconClose = document.getElementById('icon-close')
    const navLinks = document.querySelectorAll('.mobile-nav-link')

    if (!menuBtn || !mobileMenu || !mobileOverlay || !iconOpen || !iconClose)
      return

    function openMenu() {
      menuBtn?.setAttribute('aria-expanded', 'true')
      mobileMenu?.classList.remove('-translate-x-full')
      mobileOverlay?.classList.remove('opacity-0', 'pointer-events-none')
      iconOpen?.classList.add('hidden')
      iconClose?.classList.remove('hidden')
      document.body.style.overflow = 'hidden'
    }

    function closeMenu() {
      menuBtn?.setAttribute('aria-expanded', 'false')
      mobileMenu?.classList.add('-translate-x-full')
      mobileOverlay?.classList.add('opacity-0', 'pointer-events-none')
      iconOpen?.classList.remove('hidden')
      iconClose?.classList.add('hidden')
      document.body.style.overflow = ''
    }

    function toggleMenu(e: Event) {
      e.stopPropagation()
      const isOpen = menuBtn?.getAttribute('aria-expanded') === 'true'
      if (isOpen) {
        closeMenu()
      } else {
        openMenu()
      }
    }

    // Eventos
    menuBtn.addEventListener('click', toggleMenu)
    mobileOverlay.addEventListener('click', closeMenu)

    navLinks.forEach((link) => {
      link.addEventListener('click', closeMenu)
    })

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu()
    })
  }

  // Carga inicial y compatibilidad con Astro View Transitions
  setupHeader()
  document.addEventListener('astro:after-swap', setupHeader)
</script>

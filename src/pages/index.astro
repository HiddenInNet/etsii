---
import Layout from '@/layouts/Layout.astro'
import { home } from '@/data/tabs.json'
---

<Layout title={home.title} description={home.description}>
  --- // Puedes importar componentes de UI de Astro o utilizar iconos en SVG ---

  <section
    class="relative flex min-h-screen w-full items-center justify-center overflow-hidden bg-neutral-950 pt-28 pb-16 font-mono text-white"
  >
    <!-- Malla de fondo estilo Cybergrid / Matriz -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,#1f293715_1px,transparent_1px),linear-gradient(to_bottom,#1f293715_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)] bg-[size:4rem_4rem]"
    >
    </div>

    <!-- Luces Neón de Fondo (Glow Effect) -->
    <div
      class="pointer-events-none absolute -top-20 left-1/2 h-96 w-[36rem] -translate-x-1/2 rounded-full bg-yellow-400/10 blur-[120px]"
    >
    </div>
    <div
      class="pointer-events-none absolute right-10 bottom-10 h-72 w-72 rounded-full bg-yellow-400/5 blur-[100px]"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div
        class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-8"
      >
        <!-- COLUMNA IZQUIERDA: INFORMACIÓN Y CALL TO ACTION -->
        <div class="flex flex-col items-start gap-6 lg:col-span-7">
          <!-- Badge Terminal / System Status -->
          <div
            class="inline-flex items-center gap-2 rounded-full border border-yellow-400/30 bg-neutral-900/80 px-3.5 py-1.5 text-xs text-neutral-300 shadow-[0_0_15px_rgba(250,204,21,0.1)] backdrop-blur-md"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-yellow-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex h-2 w-2 rounded-full bg-yellow-400"
              ></span>
            </span>
            <span class="font-bold text-yellow-400">// SYSTEM.READY</span>
            <span class="text-neutral-600">|</span>
            <span>Curso Académico 2026/27</span>
          </div>

          <!-- Título Principal con Efecto Glitch y Resplandor -->
          <h1
            class="text-3xl leading-tight font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
          >
            Escuela Técnica Superior de <br class="hidden sm:inline" />
            <span
              class="relative inline-block bg-linear-to-r from-yellow-300 via-yellow-400 to-amber-500 bg-clip-text text-transparent drop-shadow-[0_0_20px_rgba(250,204,21,0.4)]"
            >
              Ingeniería Informática
            </span>
          </h1>

          <!-- Subtítulo / Descripción -->
          <p
            class="max-w-2xl text-sm leading-relaxed text-neutral-400 sm:text-base"
          >
            Formando a los líderes de la innovación tecnológica, el desarrollo
            de software y la inteligencia artificial en la <span
              class="font-semibold text-yellow-400">Universidad de Sevilla</span
            >.
          </p>

          <!-- Botones de Acción (CTAs) -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#docencia"
              class="group relative inline-flex items-center gap-2 overflow-hidden rounded-lg bg-yellow-400 px-6 py-3.5 text-xs font-bold tracking-wider text-neutral-950 uppercase transition-all duration-300 hover:bg-yellow-300 hover:shadow-[0_0_25px_rgba(250,204,21,0.5)] active:scale-95"
            >
              <span>Explorar Titulaciones</span>
              <span
                class="transition-transform duration-200 group-hover:translate-x-1"
                >&rarr;</span
              >
            </a>

            <a
              href="#escuela"
              class="group inline-flex items-center gap-2 rounded-lg border border-neutral-800 bg-neutral-900/60 px-6 py-3.5 text-xs font-bold tracking-wider text-neutral-300 uppercase backdrop-blur-md transition-all duration-300 hover:border-yellow-400/50 hover:bg-neutral-800/80 hover:text-yellow-400 hover:shadow-[0_0_15px_rgba(250,204,21,0.15)] active:scale-95"
            >
              <span>&lt; Conoce la ETSII /&gt;</span>
            </a>
          </div>
        </div>

        <!-- COLUMNA DERECHA: ELEMENTO INTERACTIVO / TERMINAL MOCKUP -->
        <div class="relative lg:col-span-5">
          <!-- Marco Cyberpunk Decorativo -->
          <div
            class="relative rounded-2xl border border-yellow-400/30 bg-neutral-900/90 p-5 shadow-[0_0_30px_rgba(0,0,0,0.8)] backdrop-blur-xl"
          >
            <!-- Adornos de esquina tech -->
            <div
              class="absolute -top-1 -left-1 h-3 w-3 border-t-2 border-l-2 border-yellow-400"
            >
            </div>
            <div
              class="absolute -top-1 -right-1 h-3 w-3 border-t-2 border-r-2 border-yellow-400"
            >
            </div>
            <div
              class="absolute -bottom-1 -left-1 h-3 w-3 border-b-2 border-l-2 border-yellow-400"
            >
            </div>
            <div
              class="absolute -right-1 -bottom-1 h-3 w-3 border-r-2 border-b-2 border-yellow-400"
            >
            </div>

            <!-- Cabecera de la Terminal -->
            <div
              class="mb-4 flex items-center justify-between border-b border-neutral-800 pb-3"
            >
              <div class="flex items-center gap-2">
                <span class="inline-block h-3 w-3 rounded-full bg-red-500/80"
                ></span>
                <span class="inline-block h-3 w-3 rounded-full bg-yellow-500/80"
                ></span>
                <span class="inline-block h-3 w-3 rounded-full bg-green-500/80"
                ></span>
              </div>
              <span class="font-mono text-[11px] text-neutral-500"
                >etsii-us:~$/init.sh</span
              >
            </div>

            <!-- Contenido de la Consola de Código -->
            <div
              class="space-y-3 font-mono text-xs leading-relaxed text-neutral-300"
            >
              <p class="text-neutral-500">
                &gt; Iniciando protocolo de la Escuela...
              </p>
              <p>
                <span class="text-yellow-400">const&nbsp;</span>
                <span class="text-blue-400">etsii</span> = <span
                  class="text-purple-400"
                  >new&nbsp;
                </span>
                <span class="text-green-400">Universidad</span>({'{'}
              </p>
              <p class="pl-4">
                <span class="text-neutral-400">nombre:</span>
                <span class="text-amber-300">'ETSII Sevilla'</span>,
              </p>
              <p class="pl-4">
                <span class="text-neutral-400">innovacion:</span>
                <span class="text-yellow-400">true</span>,
              </p>
              <p class="pl-4">
                <span class="text-neutral-400">ofertaFormativa:</span> [
              </p>
              <p class="pl-8 text-amber-300">'Ingeniería Informática'</p>
              <p class="pl-8 text-amber-300">'Ing. del Software'</p>
              <p class="pl-8 text-amber-300">'Ing. de Computadores'</p>
              <p class="pl-8 text-amber-300">'Tecnologías Informáticas'</p>
              <p class="pl-4">]</p>
              <p>{'}'});</p>

              <p class="pt-2 text-neutral-500">
                &gt; <span class="text-green-400">Status:</span> Sistema en ejecución.
                Bienvenido al futuro.
              </p>
            </div>

            <div
              class="mt-6 flex items-center justify-between rounded-lg border border-neutral-800 bg-neutral-950/60 p-3"
            >
              <div class="flex items-center gap-3">
                <div class="rounded-md bg-yellow-400/10 p-2 text-yellow-400">
                  <svg
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-xs font-bold text-white">
                    Investigación I+D+i
                  </p>
                  <p class="text-[10px] text-neutral-400">
                    Grupos de alto rendimiento en IA y Robótica
                  </p>
                </div>
              </div>
              <span class="h-2 w-2 animate-pulse rounded-full bg-green-400"
              ></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
